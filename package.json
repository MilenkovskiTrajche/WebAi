{
  "name": "bezisten-restaurant",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "generate:menu": "tsx scripts/generate-menu-pdf.ts",
    "build": "npm run typecheck && npm run generate:branding && npm run generate:menu && vite build && tsx scripts/generate-static.ts",
    "preview": "node scripts/serve-static.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:branding": "node --import tsx scripts/generate-branding.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.0.0",
    "@fontsource/cormorant-garamond": "^5.2.0",
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/noto-sans": "^5.2.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/svg-to-pdfkit": "^0.1.4",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.0.0",
    "fontkit": "^2.0.4",
    "pdfjs-dist": "^6.3.289",
    "pdfkit": "^0.17.0",
    "prettier": "^3.9.8",
    "svg-to-pdfkit": "^0.1.8",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
